# Postgres da própria stack (self-hosted na VPS, contêiner ceramica-db).
#
# Em produção o compose monta esta URL a partir de POSTGRES_SENHA, que fica
# no /opt/ceramica/.env da VPS (chmod 600) e nunca no repositório.
#
# Para desenvolver, suba um Postgres local:
#   docker run -d --name ceramica-db-dev -e POSTGRES_PASSWORD=dev \
#     -e POSTGRES_DB=ceramica -p 5432:5432 postgres:17-alpine
# e depois `npm run migrar`.
DATABASE_URL=postgres://ceramica:dev@localhost:5432/ceramica

# InfiniteTag da Isabela, sem o "$". É o que identifica a conta na API de
# Checkout da InfinitePay — não há chave de API.
#
# Além disto, é preciso ligar "Checkout externo" em
# app.infinitepay.io/external-checkout → Configurações. Sem isso a API responde
# `external_checkout_not_enabled` e nenhum link de pagamento é criado.
INFINITEPAY_HANDLE=

# Origem absoluta usada para montar as URLs de retorno e de webhook.
# Em produção vem do compose; em desenvolvimento, o próprio host da requisição.
# SITE_ORIGEM=https://belaceramica.prismax.tech

# SÓ DESENVOLVIMENTO: aponta a API de pagamento para um dublê local, para
# exercitar o fluxo sem conta real. IGNORADA em produção, de propósito — uma
# variável capaz de redirecionar para onde vão os dados do pagamento seria um
# belo alvo.
# INFINITEPAY_BASE=http://localhost:4599
