# Supabase — https://supabase.com/dashboard  (Project Settings → API)
# URL pública do projeto (pode aparecer no cliente):
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# service_role key — SEGREDO. Usada só no route handler (servidor).
# NUNCA prefixe com NEXT_PUBLIC_ e nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY
